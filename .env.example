APP_NAME=HE-5
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
APP_URL=https://tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=he5_db
DB_USERNAME=tu_usuario_db
DB_PASSWORD=tu_password_db

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@dominio.com
MAIL_PASSWORD=tu_password_smtp
MAIL_FROM_ADDRESS="noreply@academia-he5.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Stripe — Obtener en https://dashboard.stripe.com → Developers → API Keys
STRIPE_KEY=pk_live_XXXXXXXXXX
STRIPE_SECRET=sk_live_XXXXXXXXXX
# Webhook secret — Configurar en Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXX

# WHATSAPP API SETTINGS (opcional)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SENDER_PHONE=
