import React, { useState, useMemo } from 'react';
import { Head, Link, useForm, router } from '@inertiajs/react';
import { Users, LogOut, ArrowLeft, Plus, X, UserPlus, Search, Download, Camera } from 'lucide-react';

export default function Index({ auth, playersByCategory, parents, flash }) {
    const [isPlayerModalOpen, setIsPlayerModalOpen] = useState(false);
    const [isParentModalOpen, setIsParentModalOpen] = useState(false);

    // ── Search & Tabs State ──
    const categories = Object.keys(playersByCategory);
    const [activeTab, setActiveTab] = useState(categories.length > 0 ? categories[0] : '');
    const [searchTerm, setSearchTerm] = useState('');

    // Filter players based on search and tab
    const filteredPlayers = useMemo(() => {
        if (!playersByCategory) return [];
        
        let allPlayers = [];
        if (searchTerm.trim() !== '') {
            // Global search across all categories
            Object.values(playersByCategory).forEach(catPlayers => {
                allPlayers = [...allPlayers, ...catPlayers];
            });
            return allPlayers.filter(p => 
                `${p.first_name} ${p.last_name}`.toLowerCase().includes(searchTerm.toLowerCase()) ||
                (p.curp && p.curp.toLowerCase().includes(searchTerm.toLowerCase()))
            );
        } else {
            // Return only players in active tab
            return playersByCategory[activeTab] || [];
        }
    }, [playersByCategory, activeTab, searchTerm]);

    // ── Formulario de jugador único (con foto) ──
    const playerForm = useForm({
        first_name: '',
        last_name: '',
        curp: '',
        jersey_number: '',
        date_of_birth: '',
        category: '',
        parent_ids: [],
        photo: null,
    });

    const [photoPreview, setPhotoPreview] = useState(null);

    const handlePhotoChange = (e) => {
        const file = e.target.files[0];
        if (file) {
            playerForm.setData('photo', file);
            setPhotoPreview(URL.createObjectURL(file));
        }
    };

    const handleParentToggle = (parentId) => {
        const currentIds = playerForm.data.parent_ids;
        if (currentIds.includes(parentId)) {
            playerForm.setData('parent_ids', currentIds.filter(id => id !== parentId));
        } else {
            playerForm.setData('parent_ids', [...currentIds, parentId]);
        }
    };

    const submitPlayer = (e) => {
        e.preventDefault();
        playerForm.post(route('players.store'), {
            onSuccess: () => {
                setIsPlayerModalOpen(false);
                playerForm.reset();
                setPhotoPreview(null);
            },
        });
    };

    // ── Formulario de nuevo tutor ──
    const parentForm = useForm({
        name: '',
        username: '',
        phone: '',
    });

    const submitParent = (e) => {
        e.preventDefault();
        parentForm.post(route('parents.store'), {
            onSuccess: () => {
                setIsParentModalOpen(false);
                parentForm.reset();
            },
        });
    };

    return (
        <div className="min-h-screen bg-gray-50 font-sans">
            <Head title="Gestión de Jugadores" />

            <nav className="bg-[#0033A0] text-white shadow-lg sticky top-0 z-40">
                <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div className="flex justify-between h-16 items-center">
                        <div className="flex items-center space-x-3">
                            <span className="font-heading font-bold text-xl tracking-wider">HE-5 Admin</span>
                        </div>
                        <div className="flex items-center space-x-6">
                            <Link href="/dashboard" className="hidden sm:flex items-center space-x-2 hover:text-blue-200 transition-colors">
                                <ArrowLeft className="w-5 h-5" />
                                <span>Volver</span>
                            </Link>
                            <Link href="/logout" method="post" as="button" className="hover:text-red-300 transition-colors">
                                <LogOut className="w-5 h-5" />
                            </Link>
                        </div>
                    </div>
                </div>
            </nav>

            <main className="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">

                {flash?.success && (
                    <div className="mb-6 p-4 bg-green-50 border border-green-200 text-green-800 rounded-xl font-medium">
                        ✅ {flash.success}
                    </div>
                )}

                <div className="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
                    <div>
                        <h1 className="text-3xl font-bold text-slate-800">Jugadores</h1>
                        <p className="text-slate-600 mt-1">Gestión por categorías</p>
                    </div>
                    <div className="flex flex-wrap gap-2 w-full sm:w-auto">
                        <button
                            onClick={() => setIsParentModalOpen(true)}
                            className="flex-1 sm:flex-none bg-blue-100 text-[#0033A0] px-4 py-2.5 rounded-xl font-bold hover:bg-blue-200 transition-colors flex justify-center items-center space-x-2"
                        >
                            <UserPlus className="w-5 h-5" />
                            <span className="hidden sm:inline">Nuevo Tutor</span>
                        </button>
                        <button
                            onClick={() => setIsPlayerModalOpen(true)}
                            className="flex-1 sm:flex-none bg-[#E31837] text-white px-4 py-2.5 rounded-xl font-bold hover:bg-red-700 transition-colors flex justify-center items-center space-x-2 shadow-md"
                        >
                            <Plus className="w-5 h-5" />
                            <span>Agregar Jugador</span>
                        </button>
                    </div>
                </div>

                {/* ── Buscador ── */}
                <div className="mb-6 relative">
                    <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <Search className="h-5 w-5 text-slate-400" />
                    </div>
                    <input
                        type="text"
                        placeholder="Buscar por nombre o CURP en todas las categorías..."
                        value={searchTerm}
                        onChange={(e) => setSearchTerm(e.target.value)}
                        className="block w-full pl-10 pr-3 py-3 border border-slate-300 rounded-2xl leading-5 bg-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0033A0] focus:border-[#0033A0] sm:text-sm shadow-sm transition-shadow"
                    />
                </div>

                {/* ── Pestañas de Categoría ── */}
                {!searchTerm && categories.length > 0 && (
                    <div className="flex overflow-x-auto hide-scrollbar space-x-2 mb-6 pb-2">
                        {categories.map((cat) => (
                            <button
                                key={cat}
                                onClick={() => setActiveTab(cat)}
                                className={`whitespace-nowrap px-5 py-2.5 rounded-full font-bold text-sm transition-colors ${
                                    activeTab === cat 
                                    ? 'bg-[#0033A0] text-white shadow-md' 
                                    : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'
                                }`}
                            >
                                {cat}
                            </button>
                        ))}
                    </div>
                )}

                {/* ── Botón Descargar Excel (Visible solo cuando hay un tab activo y sin buscar) ── */}
                {!searchTerm && activeTab && (
                    <div className="mb-4 flex justify-end">
                        <a 
                            href={`/players/export/${activeTab}`} 
                            className="flex items-center space-x-2 text-green-700 bg-green-50 hover:bg-green-100 px-4 py-2 rounded-xl font-bold transition-colors"
                        >
                            <Download className="w-5 h-5" />
                            <span>Exportar Excel de {activeTab}</span>
                        </a>
                    </div>
                )}

                {/* ── Lista de Jugadores (Tarjetas Mobile First) ── */}
                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    {filteredPlayers.length > 0 ? (
                        filteredPlayers.map((player) => (
                            <div key={player.id} className="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 flex items-start space-x-4">
                                <div className="w-16 h-16 rounded-xl overflow-hidden bg-slate-100 flex-shrink-0 border border-slate-200">
                                    {player.photo_path ? (
                                        <img src={`/storage/${player.photo_path}`} alt="Foto" className="w-full h-full object-cover" />
                                    ) : (
                                        <div className="w-full h-full flex items-center justify-center text-slate-400">
                                            <Users className="w-8 h-8" />
                                        </div>
                                    )}
                                </div>
                                <div className="flex-1 min-w-0">
                                    <h3 className="font-bold text-slate-800 text-lg truncate">
                                        {player.first_name} {player.last_name}
                                    </h3>
                                    <p className="text-sm text-slate-500 mb-1">
                                        {searchTerm ? (
                                            <span className="font-medium text-[#0033A0]">{player.category}</span>
                                        ) : (
                                            <>Jersey: <span className="font-medium text-slate-700">{player.jersey_number || 'N/A'}</span></>
                                        )}
                                    </p>
                                    <div className="text-xs text-slate-500 flex flex-col space-y-1">
                                        <span>Tutores: {player.parents && player.parents.length > 0 ? player.parents.map(p => p.name).join(', ') : 'Sin asignar'}</span>
                                    </div>
                                </div>
                            </div>
                        ))
                    ) : (
                        <div className="col-span-full text-center py-12 text-slate-500 bg-white rounded-2xl shadow-sm border border-slate-200">
                            <Users className="w-12 h-12 mx-auto text-slate-300 mb-3" />
                            <p className="text-lg font-medium">No se encontraron jugadores.</p>
                        </div>
                    )}
                </div>

            </main>

            {/* ══════════════════════════════════════════════ */}
            {/* Modal: Agregar Jugador Único                  */}
            {/* ══════════════════════════════════════════════ */}
            {isPlayerModalOpen && (
                <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm">
                    <div className="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden flex flex-col max-h-[90vh]">
                        <div className="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                            <h3 className="text-xl font-bold text-slate-800">Nuevo Jugador</h3>
                            <button onClick={() => setIsPlayerModalOpen(false)} className="text-slate-400 hover:text-red-500 transition-colors">
                                <X className="w-6 h-6" />
                            </button>
                        </div>
                        <div className="p-6 overflow-y-auto">
                            <form onSubmit={submitPlayer} className="space-y-4">
                                
                                {/* FOTO CÁMARA */}
                                <div className="flex flex-col items-center justify-center mb-4">
                                    <label className="relative cursor-pointer group">
                                        <div className={`w-32 h-[3.84rem] h-40 rounded-xl overflow-hidden border-2 border-dashed ${photoPreview ? 'border-transparent' : 'border-slate-300 bg-slate-50'} flex items-center justify-center group-hover:border-[#0033A0] transition-colors`}>
                                            {photoPreview ? (
                                                <img src={photoPreview} alt="Preview" className="w-full h-full object-cover" />
                                            ) : (
                                                <div className="text-center p-2 text-slate-400">
                                                    <Camera className="w-8 h-8 mx-auto mb-1" />
                                                    <span className="text-xs">Tomar Foto</span>
                                                </div>
                                            )}
                                        </div>
                                        <input 
                                            type="file" 
                                            accept="image/*" 
                                            capture="environment" 
                                            onChange={handlePhotoChange} 
                                            className="hidden" 
                                        />
                                    </label>
                                    <p className="text-xs text-slate-400 mt-2 text-center">Formato 2.5 x 3 cm</p>
                                    {playerForm.errors.photo && <p className="text-red-500 text-xs mt-1">{playerForm.errors.photo}</p>}
                                </div>

                                <div className="grid grid-cols-2 gap-4">
                                    <div>
                                        <label className="block text-sm font-medium text-slate-700 mb-1">Nombres *</label>
                                        <input
                                            type="text"
                                            value={playerForm.data.first_name}
                                            onChange={e => playerForm.setData('first_name', e.target.value)}
                                            className="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-[#0033A0] outline-none text-slate-900 bg-white"
                                            required
                                        />
                                        {playerForm.errors.first_name && <p className="text-red-500 text-xs mt-1">{playerForm.errors.first_name}</p>}
                                    </div>
                                    <div>
                                        <label className="block text-sm font-medium text-slate-700 mb-1">Apellidos *</label>
                                        <input
                                            type="text"
                                            value={playerForm.data.last_name}
                                            onChange={e => playerForm.setData('last_name', e.target.value)}
                                            className="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-[#0033A0] outline-none text-slate-900 bg-white"
                                            required
                                        />
                                    </div>
                                </div>

                                <div>
                                    <label className="block text-sm font-medium text-slate-700 mb-1">CURP</label>
                                    <input
                                        type="text"
                                        value={playerForm.data.curp}
                                        onChange={e => playerForm.setData('curp', e.target.value.toUpperCase())}
                                        className="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-[#0033A0] outline-none text-slate-900 bg-white uppercase"
                                        maxLength="18"
                                    />
                                </div>

                                <div className="grid grid-cols-2 gap-4">
                                    <div>
                                        <label className="block text-sm font-medium text-slate-700 mb-1">Categoría</label>
                                        <select
                                            value={playerForm.data.category}
                                            onChange={e => playerForm.setData('category', e.target.value)}
                                            className="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-[#0033A0] outline-none text-slate-900 bg-white"
                                        >
                                            <option value="">Selecciona...</option>
                                            <option value="Biberon">Biberón (2021-2022)</option>
                                            <option value="Asquel">Asquel (2019-2020)</option>
                                            <option value="Diente de Leche">Diente de Leche (2017-2018)</option>
                                            <option value="Pony">Pony (2015-2016)</option>
                                            <option value="Coyote">Coyote (2013-2014)</option>
                                            <option value="Zorros">Zorros (2011-2012)</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label className="block text-sm font-medium text-slate-700 mb-1">Fecha Nac. *</label>
                                        <input
                                            type="date"
                                            value={playerForm.data.date_of_birth}
                                            onChange={e => playerForm.setData('date_of_birth', e.target.value)}
                                            className="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-[#0033A0] outline-none text-slate-900 bg-white"
                                            required
                                        />
                                    </div>
                                </div>

                                <div>
                                    <label className="block text-sm font-medium text-slate-700 mb-1">Número de Uniforme (Jersey)</label>
                                    <input
                                        type="text"
                                        value={playerForm.data.jersey_number}
                                        onChange={e => playerForm.setData('jersey_number', e.target.value)}
                                        className="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-[#0033A0] outline-none text-slate-900 bg-white"
                                        placeholder="Ej. 10"
                                    />
                                </div>

                                {parents.length > 0 && (
                                    <div>
                                        <label className="block text-sm font-medium text-slate-700 mb-1">Tutores (Opcional por ahora)</label>
                                        <p className="text-xs text-slate-500 mb-2">
                                            Selecciona al padre o madre de la lista. Si no aparece, debes registrarlo primero usando el botón "Nuevo Tutor".
                                        </p>
                                        <div className="max-h-32 overflow-y-auto border border-slate-200 rounded-xl p-2 bg-slate-50 space-y-1">
                                            {parents.map(p => (
                                                <label key={p.id} className="flex items-center space-x-2 p-2 hover:bg-white rounded-lg cursor-pointer border border-transparent hover:border-slate-200 transition-colors">
                                                    <input 
                                                        type="checkbox" 
                                                        checked={playerForm.data.parent_ids.includes(p.id)}
                                                        onChange={() => handleParentToggle(p.id)}
                                                        className="rounded border-slate-300 text-[#0033A0] focus:ring-[#0033A0]"
                                                    />
                                                    <span className="text-sm text-slate-700">{p.name}</span>
                                                </label>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                <div className="pt-4 border-t border-slate-100 flex justify-end space-x-3">
                                    <button
                                        type="button"
                                        onClick={() => setIsPlayerModalOpen(false)}
                                        className="px-5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors font-medium"
                                    >
                                        Cancelar
                                    </button>
                                    <button
                                        type="submit"
                                        disabled={playerForm.processing}
                                        className="px-5 py-2 rounded-xl bg-[#0033A0] text-white hover:bg-blue-800 transition-colors font-bold shadow-md disabled:opacity-50"
                                    >
                                        {playerForm.processing ? 'Guardando...' : 'Guardar Jugador'}
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            )}

            {/* Modal de Tutor (se mantiene igual, código recortado para brevedad o insertado completo) */}
            {isParentModalOpen && (
                <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm">
                    <div className="bg-white rounded-3xl shadow-2xl w-full max-w-md overflow-hidden flex flex-col">
                        <div className="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                            <h3 className="text-xl font-bold text-slate-800">Registrar Nuevo Tutor</h3>
                            <button onClick={() => setIsParentModalOpen(false)} className="text-slate-400 hover:text-red-500 transition-colors">
                                <X className="w-6 h-6" />
                            </button>
                        </div>
                        <div className="p-6">
                            <form onSubmit={submitParent} className="space-y-4">
                                <div>
                                    <label className="block text-sm font-medium text-slate-700 mb-1">Nombre Completo</label>
                                    <input
                                        type="text"
                                        value={parentForm.data.name}
                                        onChange={e => parentForm.setData('name', e.target.value)}
                                        className="w-full px-4 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-[#0033A0] outline-none text-slate-900 bg-white"
                                        required
                                    />
                                </div>
                                <div>
                                    <label className="block text-sm font-medium text-slate-700 mb-1">Usuario</label>
                                    <input
                                        type="text"
                                        value={parentForm.data.username}
                                        onChange={e => parentForm.setData('username', e.target.value)}
                                        className="w-full px-4 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-[#0033A0] outline-none text-slate-900 bg-white"
                                        required
                                    />
                                </div>
                                <div className="pt-4 border-t border-slate-100 flex justify-end space-x-3">
                                    <button
                                        type="button"
                                        onClick={() => setIsParentModalOpen(false)}
                                        className="px-5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 font-medium"
                                    >
                                        Cancelar
                                    </button>
                                    <button
                                        type="submit"
                                        disabled={parentForm.processing}
                                        className="px-5 py-2 rounded-xl bg-[#0033A0] text-white font-bold"
                                    >
                                        {parentForm.processing ? 'Guardando...' : 'Registrar'}
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            )}
        </div>
    );
}
